{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/og-url.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/start",
      "destination": "/create.html"
    },
    {
      "source": "/new",
      "destination": "/create.html"
    },
    {
      "source": "/g/:slug",
      "destination": "/record.html"
    },
    {
      "source": "/r/:slug",
      "destination": "/reveal.html"
    },
    {
      "source": "/m/:slug",
      "destination": "/manage.html"
    },
    {
      "source": "/login",
      "destination": "/account.html"
    },
    {
      "source": "/signup",
      "destination": "/account.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/gifts",
      "destination": "/account.html"
    },
    {
      "source": "/admin/asr",
      "destination": "/asr.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "demo/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
